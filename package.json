{
  "name": "html-share-hub",
  "version": "1.0.1",
  "description": "Desktop app to drag & drop HTML wireframes and share live over LAN",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "uongngocson",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.uongngocson.htmlsharehub",
    "productName": "HTML Share Hub",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HTML Share Hub",
      "artifactName": "HTML-Share-Hub-Setup.${ext}"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "uploads/**/*",
      "assets/**/*"
    ]
  }
}
